<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:flow_horizontalAlign="center">
    <TextView
        android:id="@+id/title_slid"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="@string/tso"
        app:layout_constraintBottom_toTopOf="@id/img_slid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textAllCaps="false"
        android:textAlignment="center"
        android:textSize="24sp"
        android:fontFamily="@font/title_slid_font"
        android:textColor="@color/text_main_color"/>

    <ImageView
        android:id="@+id/img_slid"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:layout_margin="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/slide_one"/>
    <TextView
        android:id="@+id/des_slid"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:text="@string/dso"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_slid"
        android:textColor="@color/gray"
        android:fontFamily="@font/des_slid_font"
        android:textSize="18sp"
        android:textAlignment="textStart"
        android:justificationMode="inter_word"
        android:textFontWeight="800"
        android:textDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>