<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="390dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="5dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_margin="10dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_notif_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="20dp">
        <ImageView
            android:id="@+id/iconNotif"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/light_green"
            android:src="@drawable/arrow_right"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type"
            android:textFontWeight="800"
            android:textDirection="ltr"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:fontFamily="@font/title_cat_ex"
            android:id="@+id/typeNotif"
            app:layout_constraintTop_toTopOf="@id/iconNotif"
            app:layout_constraintBottom_toBottomOf="@id/iconNotif"
            app:layout_constraintStart_toEndOf="@id/iconNotif"
            android:layout_marginStart="10dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:visibility="gone"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="message"
        android:textFontWeight="800"
        android:textDirection="ltr"
        android:textColor="@color/dark_red"
        android:textSize="14sp"
        android:fontFamily="@font/account_ans_font"
        android:id="@+id/messageNotif"
        app:layout_constraintStart_toStartOf="@id/item_notif_btn"
        app:layout_constraintTop_toBottomOf="@id/item_notif_btn"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"/>
    <TextView
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MissingCount:10"
        android:textFontWeight="800"
        android:textDirection="ltr"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:fontFamily="@font/account_ans_font"
        android:id="@+id/missingNotif"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/item_notif_btn"
        app:layout_constraintBottom_toBottomOf="@id/item_notif_btn"
       android:layout_marginEnd="25dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>