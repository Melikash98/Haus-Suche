<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AccountActivity"
    android:background="@color/main_back">

    <ImageView
        android:id="@+id/profile_image_account"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:src="@drawable/profile_account"
        android:scaleType="center"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="45dp"
        android:layout_marginEnd="35dp">
        <ImageView
            android:id="@+id/notification_account"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/notif"
            android:tint="@color/black"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/notification_dot_account"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/notification"
            android:tint="@color/gold"
            app:layout_constraintEnd_toEndOf="@id/notification_account"
            android:layout_marginEnd="-10dp"
            app:layout_constraintTop_toTopOf="@id/notification_account"
            android:layout_marginTop="-9dp"
            android:visibility="gone"/>
        <ImageButton
            android:id="@+id/message_account"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/messages"
            android:backgroundTint="@color/black"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toEndOf="@id/notification_account"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginVertical="0dp"
        app:layout_constraintTop_toBottomOf="@id/profile_image_account"
        android:paddingBottom="200dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="400dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="100dp">
                <ImageView
                    android:id="@+id/edit_btn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/edit_btn"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginEnd="30dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/black"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="30dp"
                    android:id="@+id/basicInfoBtn">
                    <ImageView
                        android:id="@+id/iconBasicAC"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="30dp"
                        android:background="@drawable/arrow_right"
                        app:layout_constraintBottom_toBottomOf="@id/infoTxtAc"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/infoTxtAc" />

                    <TextView
                        android:id="@+id/infoTxtAc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:fontFamily="@font/title_info"
                        android:text="@string/basic_info"
                        android:textAlignment="center"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textFontWeight="800"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:id="@+id/basic_ifo_layout_account"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/basicInfoBtn"
                    app:layout_constraintStart_toStartOf="@id/basicInfoBtn"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    android:paddingStart="20dp">
                    <LinearLayout
                        android:id="@+id/name_layout_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/name"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            android:fontFamily="@font/account_ans_font"/>
                        <TextView
                            android:id="@+id/name_account"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Melika Shooryabi"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:layout_marginStart="15dp"
                            android:textFontWeight="500"
                            android:fontFamily="@font/account_ans_font"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/userName_layout_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/name_layout_account"
                        app:layout_constraintStart_toStartOf="@id/name_layout_account"
                        android:layout_marginTop="5dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/username"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            android:fontFamily="@font/account_ans_font"/>
                        <TextView
                            android:id="@+id/userName_account"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Melika_sh_98"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:layout_marginStart="15dp"
                            android:textFontWeight="500"
                            android:fontFamily="@font/account_ans_font"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/location_layout_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/userName_layout_account"
                        app:layout_constraintStart_toStartOf="@id/userName_layout_account"
                        android:layout_marginTop="5dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/location"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            android:fontFamily="@font/account_ans_font"/>
                        <TextView
                            android:id="@+id/location_account"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Qatar,Doha"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:layout_marginStart="15dp"
                            android:textFontWeight="500"
                            android:fontFamily="@font/account_ans_font"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/email_layout_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/location_layout_account"
                        app:layout_constraintStart_toStartOf="@id/location_layout_account"
                        android:layout_marginTop="5dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/email"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            android:fontFamily="@font/account_ans_font"/>
                        <TextView
                            android:id="@+id/email_account"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Melika.sh.pc@gmail.com"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:layout_marginStart="15dp"
                            android:textFontWeight="500"
                            android:fontFamily="@font/account_ans_font"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/phone_layout_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/email_layout_account"
                        app:layout_constraintStart_toStartOf="@id/email_layout_account"
                        android:layout_marginTop="5dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/phone"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            android:fontFamily="@font/account_ans_font"/>
                        <TextView
                            android:id="@+id/phone_account"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0987654321"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:layout_marginStart="15dp"
                            android:textFontWeight="500"
                            android:fontFamily="@font/account_ans_font"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/basic_ifo_layout_account"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="30dp"
                    android:id="@+id/moreInfoBtn">
                    <ImageView
                        android:id="@+id/iconMoreAc"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="30dp"
                        android:background="@drawable/arrow_right"
                        app:layout_constraintBottom_toBottomOf="@id/moreInfoBtn"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/moreInfoBtn" />

                    <TextView
                        android:id="@+id/moreTxtAc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:fontFamily="@font/title_info"
                        android:text="@string/more_info"
                        android:textAlignment="center"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textFontWeight="800"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:id="@+id/more_ifo_layout_account"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    app:layout_constraintTop_toBottomOf="@id/moreInfoBtn"
                    app:layout_constraintStart_toStartOf="@id/moreInfoBtn"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="20dp"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/birth_layout_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/birthday"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            android:fontFamily="@font/account_ans_font"/>
                        <TextView
                            android:id="@+id/birth_account"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12,May, 2000"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:layout_marginStart="15dp"
                            android:textFontWeight="500"
                            android:fontFamily="@font/account_ans_font"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/job_layout_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        app:layout_constraintTop_toBottomOf="@id/birth_layout_account">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/job"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            android:fontFamily="@font/account_ans_font"/>
                        <TextView
                            android:id="@+id/job_account"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Programming"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:layout_marginStart="15dp"
                            android:textFontWeight="500"
                            android:fontFamily="@font/account_ans_font"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/petLayout_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/job_layout_account"
                        android:layout_marginTop="5dp"
                        app:layout_constraintStart_toStartOf="@id/job_layout_account">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pet"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            android:fontFamily="@font/account_ans_font"/>
                        <TextView
                            android:id="@+id/pet_type_account"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dog"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:layout_marginStart="15dp"
                            android:textFontWeight="500"
                            android:fontFamily="@font/account_ans_font"/>


                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/famileLayout_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/petLayout_account"
                        android:layout_marginTop="5dp"
                        app:layout_constraintStart_toStartOf="@id/petLayout_account">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/marriage"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            android:fontFamily="@font/account_ans_font"/>
                        <TextView
                            android:id="@+id/marriage_account"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Single"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:layout_marginStart="15dp"
                            android:textFontWeight="500"
                            android:fontFamily="@font/account_ans_font"/>

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/familyLayout_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/famileLayout_account"
                        android:layout_marginTop="5dp"
                        app:layout_constraintStart_toStartOf="@id/famileLayout_account">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/childeren"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            android:fontFamily="@font/account_ans_font"/>
                        <TextView
                            android:id="@+id/family_number_account"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:layout_marginStart="15dp"
                            android:textFontWeight="500"
                            android:fontFamily="@font/account_ans_font"/>

                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/more_ifo_layout_account"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="30dp"
                    android:id="@+id/optionInfoBtn">
                    <ImageView
                        android:id="@+id/iconOpAc"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="30dp"
                        android:background="@drawable/arrow_right"
                        app:layout_constraintBottom_toBottomOf="@id/optionInfoBtn"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/optionInfoBtn" />

                    <TextView
                        android:id="@+id/opTxtAc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:fontFamily="@font/title_info"
                        android:text="@string/optional_documents"
                        android:textAlignment="center"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textFontWeight="800"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/docRec"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="30dp"
                        android:layout_marginEnd="25dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/optionInfoBtn"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/docRec"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="60dp"
                    android:paddingStart="30dp"
                    android:id="@+id/activityInfoBtn">

                    <TextView
                        android:id="@+id/activityTxtAc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/title_cat_ex"
                        android:text="@string/user_activity"
                        android:textAlignment="center"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textFontWeight="800"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/activityRec"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/activityInfoBtn"
                    android:layout_marginTop="20dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/activityRec"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="40dp"
                    android:paddingStart="30dp"
                    android:id="@+id/recentlyInfoBtn">

                    <TextView
                        android:id="@+id/recentlyTxtAc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/title_cat_ex"
                        android:text="@string/recently"
                        android:textAlignment="center"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textFontWeight="800"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recentlyRec"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/recentlyInfoBtn"
                    android:layout_marginTop="20dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.nafis.bottomnavigation.NafisBottomNavigation
            android:id="@+id/accountBar"
            android:layout_marginBottom="50dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:mbn_circleColor="@color/white"
            app:mbn_backgroundBottomColor="@color/white"
            app:mbn_countBackgroundColor="@color/light_green"
            app:mbn_defaultIconColor="@color/gray"
            app:mbn_rippleColor="#2f424242"
            app:mbn_selectedIconColor="@color/black"
            app:mbn_shadowColor="#1f212121"
            app:mbn_hasAnimation="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>