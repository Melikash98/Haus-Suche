<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_items_fa"
    android:layout_margin="10dp"
    android:padding="5dp"
    android:background="@drawable/items_border_ex">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:id="@+id/realCardFavorite"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
            android:id="@+id/removeBtn"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:backgroundTint="#fb9062"
            android:background="@drawable/bookmark_saved"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:elevation="10dp" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_img_fa"
            android:layout_width="150dp"
            app:cardUseCompatPadding="false"
            app:cardPreventCornerOverlap="false"
            android:layout_height="85dp"
            app:cardCornerRadius="5dp"
            app:cardElevation="0dp"
            android:padding="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="10dp"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/img_items_fa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/house_2"
                android:scaleType="centerCrop"
                android:cropToPadding="true" />
        </com.google.android.material.card.MaterialCardView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:background="@drawable/name_bg_img_ex"
            app:layout_constraintStart_toStartOf="@id/card_img_fa"
            app:layout_constraintTop_toTopOf="@id/card_img_fa"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:alpha="0.8">
            <TextView
                android:id="@+id/name_cat_items_fa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Hose"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textFontWeight="400"
                android:textAlignment="center"
                android:fontFamily="@font/register_font"
                android:textColor="@color/black"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:id="@+id/name_items_fa"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/name_hose"
            android:textFontWeight="500"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            android:textColor="@color/black"
            android:fontFamily="@font/splash_tittle"
            app:layout_constraintTop_toBottomOf="@id/card_img_fa"
            app:layout_constraintStart_toStartOf="@id/card_img_fa"/>
        <LinearLayout
            android:id="@+id/locationBoxFa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/name_items_fa"
            app:layout_constraintTop_toBottomOf="@id/name_items_fa"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:backgroundTint="@color/gray"
                android:background="@drawable/location"
                android:layout_marginEnd="5dp"
                android:textAlignment="center"
                android:layout_marginTop="3dp"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="5dp"/>
            <TextView
                android:id="@+id/location_items_fa"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="@string/location_items"
                android:textSize="8sp"
                android:textColor="@color/gray"
                android:textFontWeight="500"
                android:fontFamily="@font/title_cat_ex"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/scoreBoxFa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="-3dp"
            app:layout_constraintTop_toTopOf="@id/name_items_fa"
            app:layout_constraintEnd_toEndOf="@id/card_img_fa">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/star"
                android:backgroundTint="@color/gold"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="5dp"/>
            <TextView
                android:id="@+id/items_score_fa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.5"
                android:textFontWeight="600"
                android:textColor="@color/black"
                android:fontFamily="@font/title_cat_ex"
                android:textSize="14sp"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/box_three_fa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingRight="20dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/card_img_fa"
            app:layout_constraintTop_toBottomOf="@id/locationBoxFa"
            android:layout_marginTop="10dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/box_one_fa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/bed_items_fa"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/d_bed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/bed_number_fa"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:id="@+id/bed_number_fa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textFontWeight="700"
                    android:textColor="@color/black"
                    android:textSize="10sp"
                    android:fontFamily="@font/number_font"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="5dp"
                    app:layout_constraintTop_toTopOf="@id/bed_items_fa"
                    app:layout_constraintBottom_toBottomOf="@id/bed_items_fa"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/box_one_fa"
                android:layout_marginStart="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/box_one_fa"
                app:layout_constraintBottom_toBottomOf="@id/box_one_fa">
                <ImageView
                    android:id="@+id/bath_items_fa"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bath"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:id="@+id/bath_number_fa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textFontWeight="700"
                    android:textColor="@color/black"
                    android:textSize="10sp"
                    android:fontFamily="@font/number_font"
                    app:layout_constraintStart_toEndOf="@id/bath_items_fa"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="5dp"
                    app:layout_constraintTop_toTopOf="@id/bath_items_fa"
                    app:layout_constraintBottom_toBottomOf="@id/bath_items_fa"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/card_img_fa"
            app:layout_constraintTop_toTopOf="@id/box_three_fa"
            app:layout_constraintBottom_toBottomOf="@id/box_three_fa">
            <ImageView
                android:id="@+id/iconDollarFa"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/dollar"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:id="@+id/price_number_fa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100000"
                app:layout_constraintStart_toEndOf="@id/iconDollarFa"
                app:layout_constraintTop_toTopOf="@id/iconDollarFa"
                app:layout_constraintBottom_toBottomOf="@id/iconDollarFa"
                android:fontFamily="@font/number_font"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:textFontWeight="800"
                android:layout_marginStart="2dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_hause_favorite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shimmer_auto_start="false"
        app:shimmer_duration="800"
        app:shimmer_intensity="0.25"
        app:shimmer_repeat_mode="restart">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/bookmarks_favorite_items_loading_ex"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="-0dp"
                android:layout_marginEnd="-10dp"
                android:background="@drawable/loading_back"
                android:cropToPadding="true"
                android:scaleType="centerCrop"
                android:src="@drawable/house_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:elevation="10dp"  />
            <View
                android:id="@+id/img_favorite_items_loading_ex"
                android:layout_width="150dp"
                android:layout_height="85dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/loading_back"
                android:cropToPadding="true"
                android:scaleType="centerCrop"
                android:src="@drawable/house_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/name_favorite_items_loading_ex"
                android:layout_width="100dp"
                android:layout_height="15dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/loading_back"
                android:cropToPadding="true"
                android:scaleType="centerCrop"
                android:src="@drawable/house_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/img_favorite_items_loading_ex" />

            <View
                android:id="@+id/location_favorite_items_loading_ex"
                android:layout_width="130dp"
                android:layout_height="15dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/loading_back"
                android:cropToPadding="true"
                android:scaleType="centerCrop"
                android:src="@drawable/house_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/name_favorite_items_loading_ex" />

            <View
                android:id="@+id/score_favorite_items_loading_ex"
                android:layout_width="30dp"
                android:layout_height="15dp"
                android:layout_marginEnd="-4dp"
                android:background="@drawable/loading_back"
                android:cropToPadding="true"
                android:scaleType="centerCrop"
                android:src="@drawable/house_2"
                app:layout_constraintBottom_toBottomOf="@id/name_favorite_items_loading_ex"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/img_favorite_items_loading_ex"
                app:layout_constraintTop_toTopOf="@id/name_favorite_items_loading_ex" />

            <View
                android:id="@+id/option_favorite_items_loading_ex"
                android:layout_width="60dp"
                android:layout_height="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="-4dp"
                android:background="@drawable/loading_back"
                android:cropToPadding="true"
                android:scaleType="centerCrop"
                android:src="@drawable/house_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/location_favorite_items_loading_ex" />

            <View
                android:id="@+id/price_favorite_items_loading_ex"
                android:layout_width="60dp"
                android:layout_height="15dp"
                android:background="@drawable/loading_back"
                android:cropToPadding="true"
                android:scaleType="centerCrop"
                android:src="@drawable/house_2"
                app:layout_constraintBottom_toBottomOf="@id/option_favorite_items_loading_ex"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/option_favorite_items_loading_ex" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>