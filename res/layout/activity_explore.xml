<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ExploreActivity"
    android:background="@color/white">
    <de.hdodenhof.circleimageview.CircleImageView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/profile_image_explore"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/profile"
        app:civ_border_width="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="45dp"
        android:layout_marginStart="25dp"
        app:civ_border_color="#FF000000"/>
    <TextView
        android:id="@+id/username_explore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/username"
        app:layout_constraintStart_toEndOf="@id/profile_image_explore"
        app:layout_constraintTop_toTopOf="@id/profile_image_explore"
        android:layout_marginStart="15dp"
        android:textColor="@color/text_main_color"
        android:textFontWeight="800"
        android:fontFamily="@font/register_font"
        android:textSize="18sp"/>
    <TextView
        android:id="@+id/nameUser_explore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/name"
        app:layout_constraintTop_toBottomOf="@id/username_explore"
        app:layout_constraintStart_toStartOf="@id/username_explore"
        android:layout_marginStart="15dp"
        android:textColor="@color/light_green"
        android:textFontWeight="700"
        android:fontFamily="@font/input_font"
        android:textSize="16sp"/>

    <ImageView
        android:id="@+id/notification_explore"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/notif"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/profile_image_explore"
        android:layout_marginEnd="25dp"/>
    <LinearLayout
        android:id="@+id/locationBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_image_explore"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/location"
            android:rotation="90"
            android:backgroundTint="@color/black"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/location"
            android:textFontWeight="800"
            android:textSize="20sp"
            android:fontFamily="@font/splash_tittle"
            android:textColor="@color/text_main_color"/>
        <ImageView
            android:id="@+id/locIcon"
            android:layout_marginStart="10dp"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/arrow_up"
            android:rotation="90"/>
    </LinearLayout>
    <TextView
        android:id="@+id/locationAddress_explore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/location_address"
        app:layout_constraintTop_toBottomOf="@id/locationBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/splash_tittle"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:textFontWeight="800"
        android:visibility="gone"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/searchBar_explore"
        android:layout_width="250dp"
        android:layout_height="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_image_explore"
        android:background="@drawable/inputs"
        android:layout_marginTop="90dp"
        android:drawablePadding="10dp"
        android:paddingStart="10dp"
        android:hint="@string/searching"
        android:textColorHint="@color/gray"
        android:drawableTint="@color/gray"
        android:drawableStart="@drawable/search"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categories_explore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchBar_explore"
        android:layout_marginTop="20dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
       app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginVertical="10dp"
        app:layout_constraintTop_toBottomOf="@id/categories_explore"
        android:paddingBottom="80dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="50dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:id="@+id/recommended_property_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/categories_explore"
                    app:layout_constraintStart_toStartOf="parent"
                    android:text="@string/recommended_property"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="40dp"
                    android:textFontWeight="800"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:fontFamily="@font/title_cat_ex"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recommended_property_explore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/recommended_property_text"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"/>
                <TextView
                    android:id="@+id/nearby_properties_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/recommended_property_explore"
                    app:layout_constraintStart_toStartOf="parent"
                    android:text="@string/nearby_properties"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="40dp"
                    android:textFontWeight="800"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:fontFamily="@font/title_cat_ex"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/nearby_properties_explore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/nearby_properties_text"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>