<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="120dp"
    android:id="@+id/card_option_item"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:padding="10dp"
    android:background="@drawable/border_option_items"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/icon_option"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/d_bed"
        android:tint="@color/light_orange"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="10dp"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/icon_option"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp">
        <TextView
            android:id="@+id/optionNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2"
            android:textAlignment="center"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:fontFamily="@font/number_font"
            android:textFontWeight="900"/>
        <TextView
            android:id="@+id/optionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bed_roome"
            android:fontFamily="@font/title_cat_ex"
            android:textFontWeight="800"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="10dp"/>
        
    </LinearLayout>
        

</androidx.constraintlayout.widget.ConstraintLayout>