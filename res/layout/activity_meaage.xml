<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MeaageActivity"
    android:background="@color/main_back">
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/searchBar_message"
        android:layout_width="250dp"
        android:layout_height="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/inputs"
        android:layout_marginTop="70dp"
        android:drawablePadding="10dp"
        android:paddingStart="10dp"
        android:hint="@string/searching"
        android:textColorHint="@color/gray"
        android:drawableTint="@color/gray"
        android:drawableStart="@drawable/search"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messageRec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchBar_message"
        android:layout_marginTop="60dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.nafis.bottomnavigation.NafisBottomNavigation
            android:id="@+id/messageBar"
            android:layout_marginBottom="50dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:mbn_circleColor="@color/white"
            app:mbn_backgroundBottomColor="@color/white"
            app:mbn_countBackgroundColor="@color/light_green"
            app:mbn_defaultIconColor="@color/gray"
            app:mbn_rippleColor="#2f424242"
            app:mbn_selectedIconColor="@color/black"
            app:mbn_shadowColor="#1f212121"
            app:mbn_hasAnimation="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>