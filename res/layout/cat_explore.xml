<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:id="@+id/card_cat_ex"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:padding="5dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/bac_cat_ex"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:background="@drawable/circle_cat_back"
        android:backgroundTint="@color/cat_one"
        app:civ_border_width="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:civ_border_color="#FF000000" />
    <ImageView
        android:id="@+id/img_cat_ex"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/cat_1"
        app:civ_border_width="2dp"
        app:layout_constraintEnd_toEndOf="@id/bac_cat_ex"
        app:layout_constraintTop_toTopOf="@id/bac_cat_ex"
        app:layout_constraintBottom_toBottomOf="@id/bac_cat_ex"
        app:layout_constraintStart_toStartOf="@id/bac_cat_ex"
        app:civ_border_color="#FF000000" />
    <TextView
        android:id="@+id/name_cat_ex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Hose"
        app:layout_constraintStart_toStartOf="@id/bac_cat_ex"
        app:layout_constraintEnd_toEndOf="@id/bac_cat_ex"
        app:layout_constraintTop_toBottomOf="@id/bac_cat_ex"
        android:layout_marginTop="8dp"
        android:textColor="@color/black"
        android:fontFamily="@font/splash_tittle"
        android:textSize="15sp"
        android:textFontWeight="700"/>

</androidx.constraintlayout.widget.ConstraintLayout>