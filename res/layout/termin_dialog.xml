<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    android:background="@drawable/bg_bottom_sheet">
    <TextView
        android:id="@+id/title_dialog_ter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/request"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:textFontWeight="700"
        android:fontFamily="@font/title_cat_ex"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="25dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="40dp"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/saveTermin"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:text="@string/set"
        android:textFontWeight="800"
        android:textSize="16sp"
        android:background="@drawable/btns"
        android:textAlignment="center"
        android:layout_marginStart="40dp"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title_dialog_ter"
        app:layout_constraintStart_toEndOf="@id/title_dialog_ter"/>
    <TextView
        android:id="@+id/dateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/title_dialog_ter"
        android:layout_marginTop="30dp"
        android:text="@string/date"
        android:textFontWeight="600"
        android:textSize="16sp"
        android:fontFamily="@font/title_cat_ex"
        android:textColor="@color/light_green"
        app:layout_constraintStart_toStartOf="@id/title_dialog_ter"
        app:layout_constraintEnd_toEndOf="@id/title_dialog_ter"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/dateTitle"
        app:layout_constraintBottom_toBottomOf="@id/dateTitle"
        app:layout_constraintStart_toEndOf="@id/dateTitle"
        app:layout_constraintEnd_toEndOf="@id/saveTermin"
        android:background="@drawable/btns"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="May,12"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <DatePicker
        android:id="@+id/dateTermin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:datePickerMode="spinner"
        android:calendarViewShown="false"
        android:spinnersShown="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/dateTitle"
        android:layout_marginTop="60dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>